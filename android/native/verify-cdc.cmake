execute_process(COMMAND "${NM}" -D --defined-only --format=posix "${LIBRARY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not inspect CDC exports: ${error}")
endif()
file(STRINGS "${HEADER}" declarations REGEX "^SYNC_API ")
foreach(declaration IN LISTS declarations)
    string(REGEX MATCH "synclite_rs_[A-Za-z0-9_]+" symbol "${declaration}")
    if(NOT symbol OR NOT symbols MATCHES "(^|\n)${symbol} ")
        message(FATAL_ERROR "Missing custom CDC ABI export: ${declaration}")
    endif()
endforeach()
if(symbols MATCHES "(^|\n)sqlite3_[A-Za-z0-9_]+ ")
    message(FATAL_ERROR "CDC sidecar must not export/interpose rusqlite's SQLite symbols")
endif()
execute_process(COMMAND "${READELF}" -d "${LIBRARY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE dynamic ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not inspect CDC dependencies: ${error}")
endif()
if(NOT dynamic MATCHES "SONAME[^\n]*\\[libsynclitecdc.so\\]")
    message(FATAL_ERROR "CDC sidecar must have SONAME libsynclitecdc.so")
endif()
string(REGEX MATCHALL "NEEDED[^\n]*" dependencies "${dynamic}")
foreach(dependency IN LISTS dependencies)
    if(NOT dependency MATCHES "\\[lib(c|dl|m)\\.so\\]")
        message(FATAL_ERROR "Unexpected CDC runtime dependency: ${dependency}")
    endif()
endforeach()
message(STATUS "Verified custom CDC exports, SQLite isolation, SONAME and Android system dependencies")